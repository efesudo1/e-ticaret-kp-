# ============================================================
# Production environment template
# ----------------------------------------------------------
# 1) Bu dosyayı sunucuda kopyala:
#    cp .env.production.example .env.production
# 2) Aşağıdaki değerleri DOLDUR (özellikle parolalar ve JWT_SECRET).
# 3) İndekslemeye karşı .env.production GIT'E COMMIT EDİLMEMELİ.
#
# Güçlü parola/secret üretmek için:
#   openssl rand -base64 32     # parola
#   openssl rand -base64 48     # JWT_SECRET
# ============================================================

# ---- Domain (Caddy otomatik HTTPS sertifikası bu domain için çekecek) ----
DOMAIN=ornek-domain.com
PUBLIC_URL=https://ornek-domain.com

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=DEGISTIR_GUCLU_ROOT_PAROLA
DB_NAME=kpi_dashboard
DB_USER=kpi_user
DB_PASSWORD=DEGISTIR_GUCLU_KULLANICI_PAROLA

# ---- JWT ----
JWT_SECRET=DEGISTIR_RASTGELE_UZUN_STRING_EN_AZ_48_KARAKTER
JWT_EXPIRES_IN=24h

# ---- Gemini AI (chatbot için) ----
# https://aistudio.google.com/apikey adresinden ücretsiz alın
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
